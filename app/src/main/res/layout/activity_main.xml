<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0f172a">

    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="System is not set"
        android:textColor="#f8fafc"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnToggleStream"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#6366f1"
        android:text="@string/start_streaming"
        android:textColor="#ffffff" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Live Diagnostics Logcat"
        android:textColor="#94a3b8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#020617"
        android:padding="8dp">

        <TextView
            android:id="@+id/logcatTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Initializing diagnostics..."
            android:textColor="#34d399"
            android:textSize="10sp" />
    </ScrollView>

</LinearLayout>