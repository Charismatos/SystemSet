<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Explicitly exclude app data from cloud backup and device-to-device migration. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
